{
  "name": "spendly",
  "version": "1.0.0",
  "description": "Spendly Personal Expense Tracker",
  "scripts": {
    "build:css": "tailwindcss -i ./expense-tracker/static/css/tailwind-input.css -o ./expense-tracker/static/css/tailwind.css --minify",
