{
  "name": "spendly-monorepo",
  "version": "1.0.0",
  "description": "Spendly Personal Expense Tracker Monorepo",
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:css": "npm run watch:css --prefix backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:css\""
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
